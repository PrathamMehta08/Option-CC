      "prompt": "pull up AMD and only show me IV over 60",
      "expect": {
        "tools": [
          {
            "tool": "applySettings",
            "args": {
              "ticker": "AMD"
            }
          },
          {
            "tool": "addCustomFilter",
            "args": {
              "conditions": [
                {
                  "field": "iv",
                  "op": "gt",
                  "value": [
                    60
