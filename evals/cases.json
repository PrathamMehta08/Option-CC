                }
              ]
            }
          }
        ]
      },
      "alternatives": [
        {
          "tool": "applySettings",
          "args": {
            "ticker": "AMD",
            "filterField": "iv",
            "filterOp": "gt",
            "filterValue": 60
          }
        }
      ]
    },
